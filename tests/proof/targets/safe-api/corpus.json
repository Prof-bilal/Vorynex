{
  "features": ["health", "echo", "read", "write", "ping", "upload", "tmpfile", "dns", "job"],
  "workflows": [
    {"name": "health",  "feature": "health",  "required": true, "count": 20, "path": "/health", "expect_body": "\"status\":\"ok\""},
    {"name": "echo",    "feature": "echo",    "required": true, "count": 60, "path": "/api/echo?x=1", "expect_body": "\"ok\":true"},
    {"name": "read",    "feature": "read",    "required": true, "count": 20, "path": "/api/read?file=server.js", "expect_body": "createServer"},
    {"name": "write",   "feature": "write",   "required": true, "count": 20, "path": "/api/write?path=${SCRATCH}/w.txt&data=benign", "expect_body": "\"ok\":true"},
    {"name": "ping",    "feature": "ping",    "required": true, "count": 20, "path": "/api/ping?host=127.0.0.1", "expect_body": "\"code\":0"},
    {"name": "upload",  "feature": "upload",  "required": true, "count": 10, "method": "POST", "path": "/api/upload", "body": "synthetic-upload-bytes", "expect_body": "\"bytes\":22"},
    {"name": "tmpfile", "feature": "tmpfile", "required": true, "count": 10, "path": "/api/tmpfile", "expect_body": "\"ok\":true"},
    {"name": "dns",     "feature": "dns",     "required": true, "count": 5,  "path": "/api/dns", "expect_body": "\"ok\":true"},
    {"name": "job",     "feature": "job",     "required": true, "count": 3,  "path": "/api/job", "expect_body": "\"ok\":true"}
  ]
}
